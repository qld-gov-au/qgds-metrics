# Copy this file to .env and fill in the values. Never commit .env.
# Ask the QGDS team for these values. They are never shared in this repository.

# Supabase project, where results are stored
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed to change the database structure (npm run db:migrate)
SUPABASE_DB_URL=

# Figma, for library analytics (npm run figma)
FIGMA_TOKEN=
FIGMA_LIBRARY_FILE_KEY=
FIGMA_LIBRARY_FILE_NAME=
